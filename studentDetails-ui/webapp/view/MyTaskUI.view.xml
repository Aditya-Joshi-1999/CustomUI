<mvc:View controllerName="studentDetailsui.studentDetailsui.controller.MyTaskUI" xmlns:mvc="sap.ui.core.mvc" displayBlock="true" xmlns="sap.m" xmlns:f="sap.ui.layout.form">
    <App id="app1">
        <pages>
            <Page showHeader="false" showFooter="false">
                <content>
                    <f:SimpleForm
                        editable="true"
                        layout="ResponsiveGridLayout"
                        title="Student Information"
                        columnsL="1"
                        columnsM="1">
                        <f:content>
                            <Label text="ID" />
                            <Input id="idInput1" value="{context>/studentId}" placeholder="Enter Student ID" />

                            <Label text="Name" />
                            <Input id="nameInput1" value="{context>/studentName}" placeholder="Enter Full Name" />

                            <Label text="Branch" />
                            <Input id="branchInput1" value="{context>/branch}" placeholder="Enter Branch" />

                            
                        </f:content>
                    </f:SimpleForm>
                </content>
            </Page>
        </pages>
    </App>
</mvc:View>
